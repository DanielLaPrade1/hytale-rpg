$C.@PageOverlay {
    $C.@Container {
        Anchor: (Width: 925, Height: 631);
        Padding: (Full: 7);
        Group #PanelContainer {
            LayoutMode: Top;
            Background: "PanelBackground.png";
            Anchor: (Width: 900, Height: 600);
            Group #TopContainer {
                LayoutMode: Left;
                Background: #152130(0.9);
                Anchor: (Width: 900, Height: 50);
                Label #HytaleRPGLabel {
                    Anchor: (Width: 250, Height: 50);
                    Text: "Hytale RPG";
                    Style: (HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #ffffff, FontSize: 25, RenderBold: true, Alignment: Center);
                }
                Group #XPBarContainer {
                    Anchor: (Width: 450, Height: 50);
                    Background: "XPBackground.png";
                    ProgressBar #XPBar {
                        Anchor: (Width: 450, Height: 50);
                        Value: 0;
                        BarTexturePath: "XPFill.png";
                    }
                }
                Group #XPLevelContainer {
                    LayoutMode: Top;
                    Padding: (Top: 2);
                    Label #XPDisplay {
                        Anchor: (Width: 200, Height: 25);
                        Padding: (Top: 5);
                        Text: "xxxx/xxxx";
                        Style: (HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #ffffff, FontSize: 25, RenderBold: true, Alignment: Center);
                    }
                    Label #LevelDisplay {
                        Anchor: (Width: 200, Height: 25);
                        Padding: (Bottom: 2);
                        Text: "(Level x)";
                        Style: (TextColor: #ffffff, FontSize: 10, Alignment: Center);
                    }
                }
            }
            Group #LINEBREAKONE {
                Background: #000000(0.9);
                Anchor: (Width: 900, Height: 5);
            }
            Group #MainContainer {
                LayoutMode: Left;
                Background: #333333(0.9);
                Anchor: (Width: 900, Height: 548);
                Group #SkillTreeNav {
                    LayoutMode: Top;
                    Background: #152130(0.5);
                    Anchor: (Width: 200, Height: 548);
                    Button #CombatNavButton {
                        Background: #090e14(0.8);
                        Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
                        Anchor: (Width: 200, Height: 75);
                        Label #CombatButtonName {
                            Style: (RenderBold: true, FontSize: 15, Alignment: Center);
                            FlexWeight: 1;
                            Text: "Combat";
                        }
                    }
                    Button #MiningNavButton {
                        Background: #090e14(0.8);
                        Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
                        Anchor: (Width: 200, Height: 75);
                        Label #MiningButtonName {
                            Style: (RenderBold: true, FontSize: 15, Alignment: Center);
                            FlexWeight: 1;
                            Text: "Mining";
                        }
                    }
                    Button #DefenseNavButton {
                        Background: #090e14(0.8);
                        Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
                        Anchor: (Width: 200, Height: 75);
                        Label #DefenseButtonName {
                            Style: (RenderBold: true, FontSize: 15, Alignment: Center);
                            FlexWeight: 1;
                            Text: "Defense";
                        }
                    }
                    Button #EnduranceNavButton {
                        Background: #090e14(0.8);
                        Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
                        Anchor: (Width: 200, Height: 75);
                        Label #EnduranceButtonName {
                            Style: (RenderBold: true, FontSize: 15, Alignment: Center);
                            FlexWeight: 1;
                            Text: "Endurance";
                        }
                    }
                }
                Group #LINEBREAKTWO {
                    Background: #000000(0.9);
                    Anchor: (Width: 5, Height: 548);
                }
                Group #SkillTreeContainer {
                    Anchor: (Width: 695, Height: 548);
                }
            }
        }
    }
}
